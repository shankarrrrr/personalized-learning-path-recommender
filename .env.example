# Copy this file to .env and fill in real values for local development / Docker.

# --- Gemini AI ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=3072
# Free-tier limit is ~100 embed req/min; pace below that.
GEMINI_EMBED_RPM_LIMIT=55
GEMINI_EMBED_MAX_RETRIES=5

# --- Auth (JWT) ---
# Generate a strong random string for production: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# --- Database ---
# SQLite file path (relative to the backend dir) or a full DATABASE_URL.
SQLITE_DB_PATH=sql_app.db
# Or a real DB in production: DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/learning

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000
